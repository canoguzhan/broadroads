# --- BroadRoads game server ---
PORT=8080
# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a secret is generated and stored in DATA_DIR/.token-secret.
TOKEN_SECRET=
# Where the JSON save file lives when DATABASE_URL is not set.
DATA_DIR=./data
# Optional PostgreSQL (Neon, Supabase, RDS, local). Accounts from the original
# site (broadroads_users table) are migrated automatically on first login.
DATABASE_URL=
# Origins allowed to call the API / open WebSockets (comma separated).
ALLOWED_ORIGINS=https://broadroads.com,https://www.broadroads.com
# Seconds a player waits in the ranked queue before bots fill empty seats.
QUEUE_BOT_WAIT=25
# Champion select length in seconds.
SELECT_TIME=40

# --- Client build (only needed when the client is hosted separately, e.g. on Vercel) ---
# VITE_SERVER_URL=https://play.broadroads.com
# Used by docker-compose / Caddy
DOMAIN=broadroads.com
